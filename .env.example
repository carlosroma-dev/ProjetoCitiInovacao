DATABASE_URL=postgresql://patio:CHANGE_ME@localhost:55435/patio
# Para o Postgres hospedado, use o certificado CA em Base64 e uma URL sem parâmetros SSL.
DATABASE_CA_BASE64=

# Acesso do vendedor. Use uma senha própria e um segredo aleatório de pelo menos 32 caracteres.
SELLER_DEMO_EMAIL=
SELLER_DEMO_PASSWORD=
SELLER_SESSION_SECRET=
# Acesso adicional ao painel para a banca.
SELLER_REVIEW_EMAIL=
SELLER_REVIEW_PASSWORD=

# Upload de fotos. Informe a URL do projeto e a chave secreta do servidor.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_CATALOG_BUCKET=catalogo
# Opcional. Base pública do bucket catalogo para as quatro fotos iniciais, sem barra final.
SUPABASE_CATALOG_URL=

# Uma chave da API da OpenAI para texto e transcrição.
OPENAI_API_KEY=
# Síntese com uma voz pt-BR. A chave precisa de acesso a Text to Speech.
ELEVENLABS_API_KEY=
# Em Minhas vozes, abra o menu da voz e copie o ID.
ELEVENLABS_VOICE_ID=
